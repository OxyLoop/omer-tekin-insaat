# Formspree endpoint used by the contact form (Ayarlar > Contact Form Ayarları)
# Formspree hesabınızdan aldığınız form endpoint URL'sini buraya yazın.
# Örnek: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# GitHub Pages alt yol (repository) desteği için kullanılır.
# Eğer site "username.github.io" adresinde barınacaksa BOŞ bırakın.
# Eğer site "username.github.io/repo-adi" adresinde barınacaksa "/repo-adi" yazın.
NEXT_PUBLIC_BASE_PATH=
