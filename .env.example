# Formspree endpoint used by the contact form (Ayarlar > Contact Form Ayarları)
# Formspree hesabınızdan aldığınız form endpoint URL'sini buraya yazın.
# Örnek: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# GitHub Pages alt yol (repository) desteği için kullanılır.
# Eğer site "username.github.io" adresinde barınacaksa BOŞ bırakın.
# Eğer site "username.github.io/repo-adi" adresinde barınacaksa "/repo-adi" yazın.
NEXT_PUBLIC_BASE_PATH=

# --- Sanity İçerik Yönetim Sistemi (CMS) ---
# Bu üç değer GİZLİ DEĞİLDİR — Sanity projesini tanımlamak için tarayıcıya
# gönderilmesi gerekir (tıpkı bir Firebase/Supabase proje ID'si gibi).
# Güvenlik, bu değerlerin gizliliğiyle değil, yalnızca yetkili Sanity
# üyelerinin yazma yapabilmesiyle sağlanır.
#
# Nereden bulunur: sanity.io/manage → ilgili proje → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Nereden bulunur: sanity.io/manage → ilgili proje → Datasets (genellikle "production")
NEXT_PUBLIC_SANITY_DATASET=production

# GROQ API sürümü — bugünün tarihini YYYY-MM-DD biçiminde kullanabilirsiniz.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# --- Yalnızca yerel geliştirme / script'ler için (GİZLİ) ---
# ÖNEMLİ: Aşağıdaki iki token ASLA NEXT_PUBLIC_ öneki almamalı, asla
# frontend koduna dahil edilmemeli ve asla commit edilmemelidir.

# Veri seti "private" (özel) yapılırsa herkese açık site derlemesinin
# okuma yapabilmesi için kullanılır. Veri seti "public" ise GEREKMEZ,
# boş bırakabilirsiniz.
# Nereden alınır: sanity.io/manage → proje → API → Tokens → Add API token → "Viewer"
SANITY_API_READ_TOKEN=

# YALNIZCA scripts/seed-sanity.mjs (içerik taşıma script'i) tarafından
# kullanılır. Bu token'a normal site çalışması için ihtiyaç YOKTUR.
# Nereden alınır: sanity.io/manage → proje → API → Tokens → Add API token → "Editor"
SANITY_API_WRITE_TOKEN=
